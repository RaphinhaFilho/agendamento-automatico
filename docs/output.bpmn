        <di:waypoint x="1415" y="125" />
        <di:waypoint x="1425" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C7_di" bpmnElement="Flow_C7">
        <di:waypoint x="1525" y="125" />

        <di:waypoint x="1205" y="125" />
        <di:waypoint x="1215" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C6_di" bpmnElement="Flow_C6">
        <di:waypoint x="1315" y="125" />

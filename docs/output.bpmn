        <di:waypoint x="995" y="125" />
        <di:waypoint x="1005" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C5_di" bpmnElement="Flow_C5">
        <di:waypoint x="1105" y="125" />

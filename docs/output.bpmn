        <di:waypoint x="785" y="125" />
        <di:waypoint x="795" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C4_di" bpmnElement="Flow_C4">
        <di:waypoint x="895" y="125" />

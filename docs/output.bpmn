        <di:waypoint x="1657" y="125" />
        <di:waypoint x="1667" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_Bot_di" bpmnElement="Participant_Bot" isHorizontal="true">
        <dc:Bounds x="50" y="270" width="690" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Bot_di" bpmnElement="Lane_Bot" isHorizontal="true">
        <dc:Bounds x="80" y="270" width="660" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecebeWebhook_di" bpmnElement="Task_RecebeWebhook">
        <dc:Bounds x="165" y="305" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Horario_di" bpmnElement="Gateway_Horario">
        <dc:Bounds x="400" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnviaMenu_di" bpmnElement="Task_EnviaMenu">
        <dc:Bounds x="585" y="605" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SolicitaDados_di" bpmnElement="Task_SolicitaDados">
        <dc:Bounds x="165" y="425" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApresentaServicos_di" bpmnElement="Task_ApresentaServicos">
        <dc:Bounds x="375" y="650" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApresentaHorarios_di" bpmnElement="Task_ApresentaHorarios">
        <dc:Bounds x="165" y="545" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnviaResumo_di" bpmnElement="Task_EnviaResumo">
        <dc:Bounds x="165" y="665" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnviaConfirmacao_di" bpmnElement="Task_EnviaConfirmacao">
        <dc:Bounds x="165" y="785" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnviaLembrete_di" bpmnElement="Task_EnviaLembrete">
        <dc:Bounds x="165" y="905" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_B1_di" bpmnElement="Flow_B1">
        <di:waypoint x="265" y="345" />
        <di:waypoint x="275" y="345" />
        <di:waypoint x="385" y="345" />
        <di:waypoint x="385" y="585" />
        <di:waypoint x="390" y="585" />
        <di:waypoint x="400" y="585" />

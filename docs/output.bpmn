<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Cliente" name="Cliente" processRef="Process_Cliente" />
    <bpmn:participant id="Participant_Bot" name="Chatbot WhatsApp" processRef="Process_Bot" />
    <bpmn:participant id="Participant_Sistema" name="Sistema de Agendamento" processRef="Process_Sistema" />
    <bpmn:participant id="Participant_Notif" name="Serviço de Notificações" processRef="Process_Notif" />
    <bpmn:participant id="Participant_Humano" name="Atendente Humano" processRef="Process_Humano" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Cliente" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Cliente">
      <bpmn:lane id="Lane_Cliente" name="Cliente">
        <bpmn:flowNodeRef>StartEvent_Cliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviaMensagem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscolheOpcao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscolheServico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscolheHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RespondeLembrete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cliente</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Cliente" name="Cliente envia mensagem">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_EnviaMensagem" name="Envia mensagem no WhatsApp">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EscolheOpcao" name="Escolhe opção no menu">
      <bpmn:incoming>Flow_B3</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EscolheServico" name="Escolhe serviço">
      <bpmn:incoming>Flow_B5</bpmn:incoming>
      <bpmn:outgoing>Flow_C4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EscolheHorario" name="Escolhe data e hora">
      <bpmn:incoming>Flow_B7</bpmn:incoming>
      <bpmn:outgoing>Flow_C5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Confirma" name="Confirma agendamento">
      <bpmn:incoming>Flow_B9</bpmn:incoming>
      <bpmn:outgoing>Flow_C6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RespondeLembrete" name="Responde lembrete">
      <bpmn:incoming>Flow_N2</bpmn:incoming>
      <bpmn:outgoing>Flow_C7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Cliente" name="Comparece ao serviço">
      <bpmn:incoming>Flow_C7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_Cliente" targetRef="Task_EnviaMensagem" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_EnviaMensagem" targetRef="Task_EscolheOpcao" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_EscolheOpcao" targetRef="Task_EscolheServico" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_EscolheServico" targetRef="Task_EscolheHorario" />
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Task_EscolheHorario" targetRef="Task_Confirma" />
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_Confirma" targetRef="Task_RespondeLembrete" />
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Task_RespondeLembrete" targetRef="EndEvent_Cliente" />
  </bpmn:process>
  <bpmn:process id="Process_Bot" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Bot">
      <bpmn:lane id="Lane_Bot" name="Chatbot">
        <bpmn:flowNodeRef>Task_RecebeWebhook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Horario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviaMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApresentaServicos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApresentaHorarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviaResumo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviaConfirmacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviaLembrete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolicitaDados</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="Task_RecebeWebhook" name="Recebe webhook">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Horario" name="Dentro do horário?">
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_EnviaMenu" name="Envia menu principal">
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_B3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SolicitaDados" name="Solicita dados do cliente">
      <bpmn:incoming>Flow_S3_No</bpmn:incoming>
      <bpmn:outgoing>Flow_B4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApresentaServicos" name="Apresenta serviços">
      <bpmn:incoming>Flow_B4</bpmn:incoming>
      <bpmn:outgoing>Flow_B5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApresentaHorarios" name="Apresenta horários livres">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
      <bpmn:outgoing>Flow_B7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EnviaResumo" name="Envia resumo do agendamento">
      <bpmn:incoming>Flow_S7</bpmn:incoming>
      <bpmn:outgoing>Flow_B9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EnviaConfirmacao" name="Envia confirmação">
      <bpmn:incoming>Flow_S9</bpmn:incoming>
      <bpmn:outgoing>Flow_B10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EnviaLembrete" name="Envia lembrete 24h antes">
      <bpmn:incoming>Flow_N1</bpmn:incoming>
      <bpmn:outgoing>Flow_N2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_B1" sourceRef="Task_RecebeWebhook" targetRef="Gateway_Horario" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="Gateway_Horario" targetRef="Task_EnviaMenu" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Task_EnviaMenu" targetRef="Task_EscolheOpcao" />
    <bpmn:sequenceFlow id="Flow_B4" sourceRef="Task_SolicitaDados" targetRef="Task_ApresentaServicos" />
    <bpmn:sequenceFlow id="Flow_B5" sourceRef="Task_ApresentaServicos" targetRef="Task_EscolheServico" />
    <bpmn:sequenceFlow id="Flow_B7" sourceRef="Task_ApresentaHorarios" targetRef="Task_EscolheHorario" />
    <bpmn:sequenceFlow id="Flow_B9" sourceRef="Task_EnviaResumo" targetRef="Task_Confirma" />
    <bpmn:sequenceFlow id="Flow_B10" sourceRef="Task_EnviaConfirmacao" targetRef="Task_RespondeLembrete" />
    <bpmn:sequenceFlow id="Flow_N1" sourceRef="Task_EnviaLembrete" targetRef="Task_RespondeLembrete" />
    <bpmn:sequenceFlow id="Flow_N2" sourceRef="Task_EnviaLembrete" targetRef="Task_RespondeLembrete" />
  </bpmn:process>
  <bpmn:process id="Process_Sistema" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sistema">
      <bpmn:lane id="Lane_Sistema" name="Sistema de Agendamento">
        <bpmn:flowNodeRef>Task_ConsultaCadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClienteExiste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistraCadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultaHorarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HorarioLivre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CriaAgendamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmaAgendamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AgendaLembrete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarcaPresenca</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="Task_ConsultaCadastro" name="Consulta cadastro">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ClienteExiste" name="Cliente existe?">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_S2_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RegistraCadastro" name="Registra/atualiza cadastro">
      <bpmn:incoming>Flow_B4</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConsultaHorarios" name="Consulta horários disponíveis">
      <bpmn:incoming>Flow_C4</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HorarioLivre" name="Horário ainda livre?">
      <bpmn:incoming>Flow_C5</bpmn:incoming>
      <bpmn:outgoing>Flow_S5_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_S5_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CriaAgendamento" name="Cria agendamento pendente">
      <bpmn:incoming>Flow_S5_Sim</bpmn:incoming>
      <bpmn:outgoing>Flow_S7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmaAgendamento" name="Confirma agendamento">
      <bpmn:incoming>Flow_C6</bpmn:incoming>
      <bpmn:outgoing>Flow_S9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AgendaLembrete" name="Agenda lembrete no cron">
      <bpmn:incoming>Flow_B10</bpmn:incoming>
      <bpmn:outgoing>Flow_S10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MarcaPresenca" name="Marca presença confirmada">
      <bpmn:incoming>Flow_C7</bpmn:incoming>
      <bpmn:outgoing>Flow_S11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Task_ConsultaCadastro" targetRef="Gateway_ClienteExiste" />
    <bpmn:sequenceFlow id="Flow_S2_Sim" sourceRef="Gateway_ClienteExiste" targetRef="Task_EscolheServico" />
    <bpmn:sequenceFlow id="Flow_S2_No" sourceRef="Gateway_ClienteExiste" targetRef="Task_SolicitaDados" />
    <bpmn:sequenceFlow id="Flow_S3_No" sourceRef="Gateway_ClienteExiste" targetRef="Task_SolicitaDados" />
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_RegistraCadastro" targetRef="Task_ApresentaServicos" />
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_ConsultaHorarios" targetRef="Task_ApresentaHorarios" />
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Gateway_HorarioLivre" targetRef="Task_ApresentaHorarios" />
    <bpmn:sequenceFlow id="Flow_S5_Sim" sourceRef="Gateway_HorarioLivre" targetRef="Task_CriaAgendamento" />
    <bpmn:sequenceFlow id="Flow_S5_No" sourceRef="Gateway_HorarioLivre" targetRef="Task_ApresentaHorarios" />
    <bpmn:sequenceFlow id="Flow_S7" sourceRef="Task_CriaAgendamento" targetRef="Task_EnviaResumo" />
    <bpmn:sequenceFlow id="Flow_S9" sourceRef="Task_ConfirmaAgendamento" targetRef="Task_EnviaConfirmacao" />
    <bpmn:sequenceFlow id="Flow_S10" sourceRef="Task_AgendaLembrete" targetRef="Task_EnviaLembrete" />
    <bpmn:sequenceFlow id="Flow_S11" sourceRef="Task_MarcaPresenca" targetRef="Task_RespondeLembrete" />
  </bpmn:process>
  <bpmn:process id="Process_Notif" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Notif">
      <bpmn:lane id="Lane_Notif" name="Serviço de Notificações">
        <bpmn:flowNodeRef>Timer_Lembrete24h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DisparaLembrete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="Timer_Lembrete24h" name="24h antes do agendamento">
      <bpmn:incoming>Flow_S10</bpmn:incoming>
      <bpmn:outgoing>Flow_N0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_DisparaLembrete" name="Dispara lembrete">
      <bpmn:incoming>Flow_N0</bpmn:incoming>
      <bpmn:outgoing>Flow_N1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_N0" sourceRef="Timer_Lembrete24h" targetRef="Task_DisparaLembrete" />
  </bpmn:process>
  <bpmn:process id="Process_Humano" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Humano">
      <bpmn:lane id="Lane_Humano" name="Atendente Humano">
        <bpmn:flowNodeRef>Task_AssumeConversa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resolve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="Task_AssumeConversa" name="Assume conversa">
      <bpmn:incoming>Flow_H0</bpmn:incoming>
      <bpmn:outgoing>Flow_H1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Resolve" name="Resolve e devolve ao bot">
      <bpmn:incoming>Flow_H1</bpmn:incoming>
      <bpmn:outgoing>Flow_H2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_H0" sourceRef="Task_RecebeWebhook" targetRef="Task_AssumeConversa" />
    <bpmn:sequenceFlow id="Flow_H1" sourceRef="Task_AssumeConversa" targetRef="Task_Resolve" />
    <bpmn:sequenceFlow id="Flow_H2" sourceRef="Task_Resolve" targetRef="EndEvent_Cliente" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AutoLayout">
    <bpmndi:BPMNPlane id="BPMNPlane_AutoLayout" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Cliente_di" bpmnElement="Participant_Cliente" isHorizontal="true">
        <dc:Bounds x="50" y="50" width="1740" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Cliente_di" bpmnElement="Lane_Cliente" isHorizontal="true">
        <dc:Bounds x="80" y="50" width="1710" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Cliente_di" bpmnElement="StartEvent_Cliente">
        <dc:Bounds x="197" y="107" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnviaMensagem_di" bpmnElement="Task_EnviaMensagem">
        <dc:Bounds x="375" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EscolheOpcao_di" bpmnElement="Task_EscolheOpcao">
        <dc:Bounds x="585" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EscolheServico_di" bpmnElement="Task_EscolheServico">
        <dc:Bounds x="795" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EscolheHorario_di" bpmnElement="Task_EscolheHorario">
        <dc:Bounds x="1005" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirma_di" bpmnElement="Task_Confirma">
        <dc:Bounds x="1215" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RespondeLembrete_di" bpmnElement="Task_RespondeLembrete">
        <dc:Bounds x="1425" y="85" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Cliente_di" bpmnElement="EndEvent_Cliente">
        <dc:Bounds x="1667" y="107" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_C1_di" bpmnElement="Flow_C1">
        <di:waypoint x="233" y="125" />
